{
  "name": "campuscore",
  "version": "0.1.0",
  "private": true,
  "description": "Decentralized campus issue-reporting network for SMU (Telegram + Convex + Next.js).",
  "scripts": {
    "dev": "next dev",
    "dev:convex": "convex dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test config/**/*.test.mjs convex/**/*.test.mjs",
    "test:pbt": "node --test --test-isolation=none config/**/*.property.test.mjs convex/**/*.property.test.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.0.0",
    "convex": "^1.17.0",
    "next": "^15.5.20",
    "onnxruntime-web": "^1.20.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.20",
    "fast-check": "3.23.2",
    "prettier": "^3.8.5",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
