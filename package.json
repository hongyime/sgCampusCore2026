{
  "name": "campuscore",
  "version": "0.1.0",
  "private": true,
  "description": "Decentralized campus issue-reporting network for SMU (Telegram + Convex + Next.js).",
  "scripts": {
    "dev": "next dev",
    "dev:convex": "convex dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test config/**/*.test.mjs convex/**/*.test.mjs",
    "test:pbt": "node --test --test-isolation=none config/**/*.property.test.mjs convex/**/*.property.test.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.5.13",
    "convex": "^1.17.0",
    "next": "^16.2.10",
    "onnxruntime-web": "^1.20.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.17.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.10",
    "fast-check": "4.8.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0"
  }
}
