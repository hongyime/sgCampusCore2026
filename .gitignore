# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# env — never commit real secrets (AGENTS.md). .env.example IS committed.
.env
.env*.local
.env.development
.env.production

# convex
.convex/
# NOTE: convex/_generated/ is INTENTIONALLY committed. Convex CLI v1.41
# runs `--cmd 'next build'` BEFORE it regenerates convex/_generated/*, so on
# a fresh Vercel clone the Next build cannot resolve @/convex/_generated/*
# imports unless the files exist in git. This matches Convex's own guidance
# in https://docs.convex.dev/cli/reference/codegen ("should be committed to
# the repo"). Reverting this gitignore was a Task-23 (session-3) fix; the
# corresponding Requirement 1.5 / 10.1 / Property 6 in the session-3 spec
# need to be updated to reflect this reality — flagged for STATUS.md.

# agent/runtime metadata
.omo/

# misc
*.tsbuildinfo
.DS_Store
*.log

# spec-execution scratch artifacts (never commit — may contain Vercel
# project metadata or PBT run stdout dumps; regenerated on demand)
pbt-out.txt
project-info.json

# vercel — .vercel/ links a local checkout to a Vercel project; never commit
.vercel

